# 서버 포트 (ngrok http 3000 으로 연결)
PORT=3000

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
# "승인된 JavaScript 원본"에 https://<내-도메인>.ngrok-free.app 와 http://localhost:3000 을 추가하세요.
GOOGLE_CLIENT_ID=

# 로그인 토큰 서명용 비밀값 (아무 긴 문자열). 비워두면 서버 재시작 때마다 다시 로그인해야 합니다.
SESSION_SECRET=

# 구글 로그인 없이 닉네임만으로 들어오는 게스트 입장 허용 여부
# GOOGLE_CLIENT_ID가 비어 있으면 자동으로 허용됩니다.
ALLOW_GUEST=True
